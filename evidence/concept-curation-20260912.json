 "tags": [
  {
   "id": "T1",
   "name": "人机分工",
   "why": "机器跑得越来越快，但方向和取舍还得有人扛。这条线帮你想清楚哪些活可以交出去，哪些必须自己拿着。",
   "color": "#5B8FF9"
  },
  {
   "id": "T2",
   "name": "智能体工作流",
   "why": "让智能体真替你干活，靠的不是提示词技巧，而是把任务拆开、把流程编排起来、让验证自己跑。",
   "color": "#61DDAA"
  },
  {
   "id": "T3",
   "name": "理解优先",
   "why": "把方案和思考整包丢给机器，人会慢慢看不懂自己在做什么。这条线标出哪些理解不能外包。",
   "color": "#F6BD16"
  },
  {
   "id": "T4",
   "name": "不可替代",
   "why": "职业不再是一条排好队的梯子，先弄清自己那门手艺长在哪，才能在被替代之前长出别人拿不走的东西。",
   "color": "#7262FD"
  },
  {
   "id": "T5",
   "name": "一人企业",
   "why": "一个人加几个工具就能撑起一门生意，但这条路上有它自己的套路和淘汰率，值得先看清再下场。",
   "color": "#78D3F8"
  },
  {
   "id": "T6",
   "name": "组织边界",
   "why": "公司为什么存在、边界会被谁划走，这件事决定了未来还有哪些岗位和协作方式，比工具评测更值得看。",
   "color": "#9661BC"
  },
  {
   "id": "T7",
   "name": "产品判断",
   "why": "模型能力每隔几个月就挪一次，什么该现在做、什么该等、什么该扔，判断错了再拼命也白费。",
   "color": "#F6903D"
  },
  {
   "id": "T8",
   "name": "验证优先",
   "why": "生成变便宜之后，贵的是确信它是对的。测试、评测和闸门决定了你到底敢不敢把东西交出去。",
   "color": "#008685"
  },
  {
   "id": "T9",
   "name": "学会学习",
   "why": "好奇、苦练、创造这三段一段都跳不过去。看懂学习本身怎么运转，比多背几个知识点管用得多。",
   "color": "#F08BB4"
  },
  {
   "id": "T10",
   "name": "数学与模型",
   "why": "数学是模型最经得起检验的战场，它在这里能做什么、卡在哪里、还需要什么样的人，都看得最清楚。",
   "color": "#7C8CE0"
  }
 ],

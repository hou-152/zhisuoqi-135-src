# 凭证与本地状态——绝不入库
.private/
.local/

# 桌面版依赖与打包产物
app/node_modules/
app/dist/
# app/assets/ 由 scripts/build-app.mjs 从 prototype/ 与 .agents/ 生成，只打包时用。
# 注：gitignore 的行内注释不生效——写成 `app/assets/  # 说明` 会让整行变成无效模式（09-12 踩过）。
app/assets/

# 系统与工具产物
.DS_Store
.mimosa/

# 部署产物（自身是独立仓库，见 deploy/zhisuoqi/README.md）
deploy/zhisuoqi/

# 本地安全备份（git 历史本身也是备份）
.trash/

# 无头浏览器验收的临时产物（scripts/shot-shell.mjs 用的是 CDP，不需要这个目录）
.playwright-cli/

# 公网发布仓库（独立 git 仓库，由 scripts/build-public.mjs 生成）
deploy/zhisuoqi-135/

# 根站（独立 git 仓库）：让 hou-152.github.io 不 404
deploy/root-site/

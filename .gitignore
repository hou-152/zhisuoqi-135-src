# 凭证与本地状态——绝不入库
.private/
.local/

# 桌面版依赖与打包产物
app/node_modules/
app/dist/
# app/assets/ 由 scripts/build-app.mjs 从 prototype/ 与 .agents/ 生成，只打包时用。
# 注：gitignore 的行内注释不生效——写成 `app/assets/  # 说明` 会让整行变成无效模式（09-12 踩过）。
app/assets/

# 系统与工具产物
.DS_Store
.mimosa/

# 管线改前备份（cm-add-neican / cm-drop-non-ai 等生成的 *.pre-*.bak）：
# 改前状态在 git 历史里就有，这些只是同一次运行内的回滚点，不入库（2026-09-14）
*.bak

# 部署产物：整个 deploy/ 都是**各自独立的 git 仓库**，不属于本仓库
# （zhisuoqi-135 = 公网 Demo ＋ 538 单元索引页；root-site = hou-152.github.io 根站；zhisuoqi = 早期的旧站）
# 2026-09-13 仓库体检：原来按目录逐条写，漏掉了旧的 deploy/zhisuoqi/，改成整目录忽略。
deploy/

# 本地安全备份（git 历史本身也是备份）
.trash/

# 无头浏览器验收的临时产物（scripts/shot-shell.mjs 用的是 CDP，不需要这个目录）
.playwright-cli/
.e2e-artifacts/


<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>知所栖 135 · AI 时代要学的每一件事</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{height:100%;overflow:hidden;background:#08080a;color:#fff;
    font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue",Arial,sans-serif;
    -webkit-font-smoothing:antialiased}
  canvas{position:fixed;inset:0;display:block;cursor:grab;touch-action:none}
  canvas.drag{cursor:grabbing}
  #ui{position:fixed;inset:0;pointer-events:none;z-index:2}
  .brand{position:absolute;top:26px;left:34px;font-size:12px;letter-spacing:.24em;
    font-weight:600;color:#fff}
  .brand span{color:#5a5a63;font-weight:400;letter-spacing:.1em;margin-left:10px}
  .tabs{position:absolute;top:56px;left:34px;display:flex;gap:6px;pointer-events:auto}
  .tab{background:none;border:1px solid #1d1d24;color:#6a6a73;font-size:11px;
    padding:6px 15px;border-radius:15px;cursor:pointer;transition:all .16s;
    font-family:inherit;letter-spacing:.06em}
  .tab:hover{color:#c8c8d0;border-color:#2e2e38}
  .tab.on{background:#1a1a22;color:#fff;border-color:#34343f}
  .hero{position:absolute;left:34px;top:50%;transform:translateY(-56%);max-width:380px}
  .kicker{font-size:10px;letter-spacing:.22em;color:#63636b;margin-bottom:16px}
  h1{font-family:Georgia,"Songti SC","Times New Roman",serif;font-size:41px;
    line-height:1.15;font-weight:400;letter-spacing:-.015em}
  .stats{margin-top:22px;font-size:12px;line-height:1.75;color:#84848d}
  .stats b{color:#e8e8ee;font-weight:500}
  .legend{position:absolute;left:34px;bottom:30px;pointer-events:auto;
    max-height:44vh;overflow:auto;scrollbar-width:none}
  .legend::-webkit-scrollbar{display:none}
  .legend h4{font-size:9.5px;letter-spacing:.2em;color:#5c5c64;margin-bottom:11px;font-weight:500}
  .lrow{display:flex;align-items:center;gap:8px;font-size:11px;color:#8e8e97;
    padding:2.5px 0;cursor:pointer;transition:color .15s,opacity .15s;white-space:nowrap;
    opacity:1}
  .lrow:hover{color:#fff}
  .lrow.off{opacity:.26}
  .dot{width:7px;height:7px;border-radius:50%;flex:0 0 7px}
  .lrow .n{margin-left:auto;color:#55555d;font-size:10px;padding-left:12px}
  .hint{position:absolute;right:34px;bottom:30px;text-align:right;font-size:10.5px;
    line-height:1.9;color:#55555d;letter-spacing:.03em}
  .hint b{color:#84848d;font-weight:500}
  #panel{position:fixed;top:0;right:0;height:100%;width:400px;background:#0d0d10;
    border-left:1px solid #1a1a1f;padding:34px 28px;transform:translateX(100%);
    transition:transform .26s cubic-bezier(.4,0,.2,1);z-index:3;overflow-y:auto}
  #panel.on{transform:none}
  #panel .close{position:absolute;top:22px;right:24px;width:28px;height:28px;
    border-radius:50%;background:#17171c;border:0;color:#8a8a93;cursor:pointer;
    font-size:15px;line-height:1}
  #panel .close:hover{background:#22222a;color:#fff}
  #panel .src{font-size:9.5px;letter-spacing:.16em;color:#63636b;margin-bottom:12px}
  #panel h2{font-family:Georgia,"Songti SC",serif;font-size:23px;line-height:1.3;
    font-weight:400;margin-bottom:16px}
  #panel .gloss{font-size:12.5px;line-height:1.85;color:#a2a2ac;margin-bottom:24px}
  #panel .metrics{display:flex;gap:22px;padding:15px 0;border-top:1px solid #1a1a1f;
    border-bottom:1px solid #1a1a1f;margin-bottom:22px}
  #panel .m{flex:1}
  #panel .m b{display:block;font-size:19px;font-weight:400;color:#fff;line-height:1.2}
  #panel .m span{font-size:9.5px;letter-spacing:.1em;color:#5c5c64}
  .markrow{display:flex;gap:7px;margin:22px 0 4px}
  .mk{flex:1;background:#141419;border:1px solid #26262f;border-radius:6px;
    color:#8e8e97;font-size:11.5px;padding:7px 0;cursor:pointer;font-family:inherit;
    transition:all .15s}
  .mk:hover{border-color:#3a3a46;color:#fff}
  .mk.on{background:rgba(94,224,192,.14);border-color:#5ee0c0;color:#5ee0c0}
  .mk.gap.on{background:rgba(255,77,77,.14);border-color:#ff4d4d;color:#ff4d4d}
  .mk.quiet{color:#55555d}
  #myrow{display:flex;align-items:center;gap:7px;font-size:11px;color:#8e8e97;
    padding:9px 0 11px;border-top:1px solid #1a1a22;margin-top:4px;flex-wrap:wrap}
  #myrow .dot{width:7px;height:7px;border-radius:50%;flex:0 0 auto}
  #myrow .n{margin-left:5px;color:#fff;font-size:10.5px}
  #panel h5{font-size:9.5px;letter-spacing:.18em;color:#5c5c64;margin:18px 0 9px;font-weight:500}
  #panel ul{list-style:none}
  #panel li{font-size:12px;line-height:1.6;color:#9a9aa4;padding:5px 0;
    border-bottom:1px solid #141418;cursor:pointer}
  #panel li:hover{color:#fff}
  #panel li em{font-style:normal;color:#55555d;font-size:10px;margin-left:6px}
  #tip{position:fixed;padding:5px 9px;background:#16161c;border:1px solid #26262e;
    border-radius:5px;font-size:11px;color:#d8d8e0;pointer-events:none;opacity:0;
    transition:opacity .12s;z-index:4;white-space:nowrap}
  #tip.on{opacity:1}
  #load{position:fixed;inset:0;display:grid;place-items:center;background:#08080a;
    z-index:9;font-size:11px;letter-spacing:.2em;color:#5c5c64;transition:opacity .4s}
  #load.off{opacity:0;pointer-events:none}
  @media(max-width:820px){
    .hero{top:auto;bottom:auto;transform:none;top:96px;max-width:200px}
    h1{font-size:28px}.stats{font-size:11px}
    .legend{bottom:auto;top:300px;max-height:30vh}
    .hint{display:none}#panel{width:100%}
  }

/* ══ 壳：左侧栏 + 底栏三入口（import / insert / Agent）══ */
#rail{position:fixed;left:0;top:0;bottom:64px;width:228px;padding:18px 14px 12px;
  display:flex;flex-direction:column;gap:14px;z-index:6;overflow:hidden;
  background:linear-gradient(180deg,rgba(8,10,14,.94),rgba(8,10,14,.66));
  backdrop-filter:blur(10px);border-right:1px solid #1b2029}
.r-brand{font-size:17px;font-weight:700;letter-spacing:.2px;color:#fff}
.r-brand span{margin-left:7px;font-size:11px;font-weight:400;color:#6b7684;
  border:1px solid #262c37;border-radius:20px;padding:1px 8px}
.r-list{display:flex;flex-direction:column;gap:3px}
.r-item{display:flex;flex-direction:column;align-items:flex-start;gap:2px;width:100%;
  background:transparent;border:0;border-radius:9px;padding:8px 10px;cursor:pointer;
  text-align:left;color:#c7ced8;font-family:inherit}
.r-item:hover{background:#161b23}
.r-item.on{background:#1d232d}
.r-item b{font-size:13.5px;font-weight:600}
.r-item.on b{color:#fff}
.r-item i{font-style:normal;font-size:11px;color:#77808d}
.r-list{flex:0 0 auto}
.r-foot{margin-top:auto;display:flex;flex-direction:column;gap:8px;min-height:0;flex:0 1 auto}
.r-tabs{display:flex;gap:6px}
.legend{font-size:11.5px;color:#98a1ad;position:static;left:auto;bottom:auto;
  flex:1 1 auto;min-height:0;overflow:auto;scrollbar-width:none}
.legend::-webkit-scrollbar{display:none}
.legend h4{font-size:10.5px;color:#5d6673;margin:8px 0 5px;font-weight:500}
.legend .lrow{display:flex;align-items:center;gap:7px;padding:2px 0;cursor:pointer}
.legend .lrow.off{opacity:.35}
.legend .dot{width:8px;height:8px;border-radius:50%;flex:0 0 8px}
.legend .n{margin-left:auto;color:#5d6673}
#hero-mini{position:fixed;left:252px;top:16px;z-index:5;pointer-events:none;max-width:430px}
#hero-mini .kicker{font-size:10.5px;color:#6b7684;letter-spacing:.6px}
#hero-mini .stats{font-size:11.5px;color:#98a1ad;line-height:1.7;margin-top:5px}
#bar{position:fixed;left:0;right:0;bottom:0;height:64px;z-index:7;display:flex;
  align-items:center;gap:8px;padding:0 16px;background:rgba(8,10,14,.95);
  backdrop-filter:blur(12px);border-top:1px solid #1b2029}
.b-btn{display:flex;flex-direction:column;align-items:flex-start;gap:1px;min-width:118px;
  background:#141920;border:1px solid #242b36;border-radius:10px;padding:7px 12px;
  cursor:pointer;color:#c7ced8;font-family:inherit}
.b-btn:hover{background:#1b212a;border-color:#39424f}
.b-btn.flash{background:#1d2a22;border-color:#2f5a41}
.b-btn b{font-size:12.5px;font-weight:700;color:#fff;font-family:ui-monospace,Menlo,monospace}
.b-btn span{font-size:10.5px;color:#77808d}
.b-input{flex:1;margin-left:6px}
.b-input input{width:100%;background:#10141a;border:1px solid #242b36;border-radius:10px;
  padding:10px 13px;color:#e6ebf2;font-size:13px;outline:none;font-family:inherit}
.b-input input:focus{border-color:#39424f}
.mut{color:#7d8794;font-size:12px;line-height:1.75}
.ilist{display:flex;flex-direction:column;gap:5px;margin:12px 0;max-height:50vh;overflow:auto}
.irow{display:flex;flex-direction:column;align-items:stretch;gap:7px;background:#12161c;
  border:1px solid #1e242e;border-radius:9px;padding:9px 11px}
.irow.keep{border-color:#2f5a41}
.irow.skip{opacity:.4}
.itxt{flex:1;font-size:12px;line-height:1.55}
.itxt b{color:#e6ebf2;font-weight:600}
.iact{display:flex;gap:5px;justify-content:flex-end}
.iact button{background:#1a2029;border:1px solid #262e3a;border-radius:7px;color:#aeb7c2;
  font-size:11px;padding:4px 9px;cursor:pointer;font-family:inherit}
.iact button.on{background:#22402f;border-color:#356b4c;color:#c9f5dd}
.alist{display:flex;flex-direction:column;gap:8px;margin:12px 0}
.acard{display:flex;flex-direction:column;align-items:flex-start;gap:3px;text-align:left;
  background:#12161c;border:1px solid #1e242e;border-radius:10px;padding:11px 13px;
  cursor:pointer;color:#c7ced8;font-family:inherit}
.acard:hover{border-color:#39424f;background:#171d25}
.acard b{font-size:13px;color:#fff}
.acard span{font-size:11.5px;color:#98a1ad}
.acard i{font-style:normal;font-size:11px;color:#69727e}

.axtog{display:flex;gap:4px;margin:6px 0 2px}
.axtog button{flex:1;background:#12161c;border:1px solid #1e242e;border-radius:7px;
  color:#7d8794;font-size:10.5px;padding:4px 0;cursor:pointer;font-family:inherit}
.axtog button.on{background:#1d232d;border-color:#39424f;color:#fff}
.crow{display:flex;flex-direction:column;gap:3px;background:#12161c;border:1px solid #1e242e;
  border-radius:10px;padding:10px 12px;margin-bottom:7px;cursor:pointer}
.crow:hover{border-color:#39424f;background:#171d25}
.crow b{font-size:13px;color:#fff;display:flex;align-items:center;gap:7px}
.crow b .dot{width:8px;height:8px;border-radius:50%}
.crow span{font-size:11.5px;color:#98a1ad;line-height:1.6}
.crow i{font-style:normal;font-size:10.5px;color:#69727e}
.stops{display:flex;flex-direction:column;gap:0;margin:10px 0}
.stop{display:flex;align-items:flex-start;gap:9px;font-size:12.5px;line-height:1.5;padding:5px 0;
  cursor:pointer;color:#c7ced8}
.stop:hover{color:#fff}
.stop .lv{flex:0 0 24px;font-size:10px;color:#69727e;font-family:ui-monospace,Menlo,monospace;
  padding-top:2px}
.stop .nm{flex:1}
.stop .ed{font-size:9.5px;color:#4f5866;padding-top:3px}
.badge{display:inline-block;font-size:9.5px;letter-spacing:.08em;border-radius:20px;
  padding:1px 7px;border:1px solid #2a3340;color:#8b95a3;margin-left:6px;vertical-align:1px}
.badge.auto{border-color:#2f5a41;color:#79c9a0}
.cmsg{margin:9px 0;padding:9px 11px;border-radius:10px;font-size:12.5px;line-height:1.75}
.cmsg.user{background:#182029;border:1px solid #232c38;color:#dbe3ec}
.cmsg.assistant{background:#111720;border:1px solid #1c2431;color:#c2ccd8}
.cmsg.pend{opacity:.55}
.clist{max-height:60vh;overflow:auto;margin-top:10px}
</style>
</head>
<body>
<canvas id="c"></canvas>
<div id="rail">
  <div class="r-brand">知所栖<span>135</span></div>
  <div class="r-list">
    <button class="r-item on" data-view="graph" onclick="setView('graph')"><b>知识体系</b><i id="r-all"></i></button>
    <button class="r-item" data-view="curate" onclick="setView('curate')"><b>策展</b><i id="r-cur"></i></button>
    <button class="r-item" data-view="todo" onclick="setView('todo')"><b>待你看一眼</b><i id="r-todo"></i></button>
    <button class="r-item" data-view="mine" onclick="setView('mine')"><b>我在学</b><i id="r-mine"></i></button>
    <button class="r-item" data-view="chat" onclick="setView('chat')"><b>对话</b><i id="r-chat">选方法论</i></button>
  </div>
  <div class="r-foot">
    <div class="r-tabs">
      <button class="tab on" data-mode="grid">图谱</button>
      <button class="tab" data-mode="sphere">星球</button>
    </div>
    <div class="legend">
      <h4>我的 · 位置不动，只变环</h4><div id="myrow"></div>
      <h4>操作</h4><div id="rhint"></div>
      <div class="axtog">
        <button id="ax-tag" class="on" onclick="setAxis('tag')">按主题</button>
        <button id="ax-src" onclick="setAxis('src')">按来源</button>
      </div>
      <h4 id="lhead">主题 · 点击筛选（策展）</h4><div id="lrows"></div>
    </div>
  </div>
</div>
<div id="hero-mini"><div class="kicker" id="kicker"></div><div class="stats" id="stats"></div></div>
<div id="bar">
  <button class="b-btn" id="b-import" onclick="doImport()"><b>import</b><span>知识体系</span></button>
  <button class="b-btn" id="b-insert" onclick="doInsert()"><b>insert</b><span>挖掘 · 提问</span></button>
  <button class="b-btn" id="b-agent"  onclick="doAgent()"><b>Agent</b><span>选方法论</span></button>
  <div class="b-input"><input id="b-q" placeholder="我想学 ____  （回车走 135 闭环）"></div>
</div>
<aside id="panel">
  <button class="close" onclick="closePanel()">✕</button>
  <div id="pbody"></div>
</aside>
<div id="tip"></div>
<div id="load">正在计算布局…</div>

<script>
const DATA = /*__DATA__*/;

/* ── 常量 ───────────────────────────────────────────── */
const PALETTE = ['#5B8FF9','#61DDAA','#F6BD16','#7262FD','#78D3F8','#9661BC',
                 '#F6903D','#00B5A3','#F08BB4','#E8684A','#6DC8EC','#A078DB'];
let   LEVEL_GAP = 88;      // 每层高度（boot 时按层数自适应）
const REPULSE   = 1650;    // 斥力
const SPRING    = 0.055;   // 边引力
const YSPRING   = 0.15;    // 层弹簧
const DAMP      = 0.86;
const ITERS     = 260;

const nodes = DATA.nodes, edges = DATA.edges, sources = DATA.sources, meta = DATA.meta;
// 策展层：主题标签 + 策展集（路线）+ 机器已判的边
const CUR = DATA.curation || { tags: [], assign: {}, collections: [], edgeAuto: [], edgeHuman: [] };
const AUTO = new Map((CUR.edgeAuto || []).map(a => [a.key, a]));
const byId = new Map(nodes.map(n => [n.id, n]));
const neighbors = new Map(nodes.map(n => [n.id, { pre: [], post: [] }]));

/* ── 状态 ───────────────────────────────────────────── */
let mode = 'grid';
let rotX = -0.22, rotY = 0.5, zoom = 1.08, panX = 0, panY = 0;
let selected = null, hovered = null, filter = null;

/* ── 我的标记层：位置永不动，只加环 ────────────────────
   learned = 学过（青环）· gap = 漏点没补（红环）· 缺省 = 没学过（无环）
   关键：布局只由 nodes/edges 决定，标记不参与任何坐标计算。 */
const MARK_KEY = 'zss135.canvas.v1';
let marks = {};
try { marks = JSON.parse(localStorage.getItem(MARK_KEY) || '{}') || {}; } catch (e) { marks = {}; }
function saveMarks() { try { localStorage.setItem(MARK_KEY, JSON.stringify(marks)); } catch (e) {} }
function refreshMarks() {
  const L = nodes.filter(n => marks[n.id] === 'learned').length;
  const G = nodes.filter(n => marks[n.id] === 'gap').length;
  const el = document.getElementById('myrow');
  if (el) el.innerHTML =
    `<span class="dot" style="background:#5ee0c0"></span>学过<span class="n">${L}</span>` +
    `<span class="dot gap" style="background:#ff4d4d;margin-left:14px"></span>漏点没补<span class="n">${G}</span>` +
    `<span class="n" style="margin-left:14px">共 ${nodes.length}</span>`;
}
function setMark(id, v) {
  if (v === 'none' || marks[id] === v) delete marks[id]; else marks[id] = v;
  saveMarks(); refreshMarks(); if (window.refreshRail) refreshRail();
  if (selected === id) openPanel(id);
}
window.setMark = setMark;
let W = 0, H = 0, CX = 0, CY = 0, DPR = 1;
const cvs = document.getElementById('c'), ctx = cvs.getContext('2d');
const tip = document.getElementById('tip');

/* ── 建立邻接 ───────────────────────────────────────── */
for (const [tid, pid] of edges) {
  neighbors.get(tid).pre.push(pid);
  neighbors.get(pid).post.push(tid);
}

/* ── 布局 ───────────────────────────────────────────── */
// 确定性伪随机：同一概念每次抖动一致，resize / 切模式不会跳动
function hash01(s) {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); }
  return ((h >>> 0) % 10000) / 10000;
}

// 图谱模式：纵轴 = 依赖层级，横轴 = 主题分列（默认·策展）/ 来源分列（可切）
let gridGap = 50, gridTop = 80, gridX0 = 0, gridColW = 60;
function layoutGrid() {
  const G = groups();
  const maxLv = Math.max(...nodes.map(n => n.level));
  const x0 = W * 0.29, x1 = W * 0.94;
  const colW = (x1 - x0) / Math.max(1, G.length);
  const gap = Math.min(54, (H * 0.78) / Math.max(1, maxLv));
  const yTop = H * 0.135;
  const buckets = G.map(() => new Map());
  for (const n of nodes) {
    const b = buckets[Math.min(giOf(n), G.length - 1)];
    if (!b.has(n.level)) b.set(n.level, []);
    b.get(n.level).push(n);
  }
  for (let ci = 0; ci < G.length; ci++) {
    for (const [lv, arr] of buckets[ci]) {
      arr.forEach((n, i) => {
        const t = arr.length === 1 ? 0.5 : i / (arr.length - 1);
        n.gx = x0 + ci * colW + colW * (0.17 + t * 0.66) + (hash01(n.id) - 0.5) * colW * 0.40;
        n.gy = yTop + lv * gap + (hash01(n.id + 'y') - 0.5) * gap * 0.55;
      });
    }
  }
  gridGap = gap; gridTop = yTop; gridX0 = x0; gridColW = colW;
}

// 星球模式：球面均布（形式参考 candobear 智慧星球）
// 不跑力导向 —— 边引力会把均匀球面拉歪；用 hash 打散顺序，颜色自然混合
function layoutSphere() {
  const R = 430;
  const order = nodes.slice().sort((a, b) => hash01(a.id) - hash01(b.id));
  const N = order.length, ga = Math.PI * (3 - Math.sqrt(5));
  order.forEach((n, i) => {
    const y = 1 - (i / Math.max(1, N - 1)) * 2;
    const r = Math.sqrt(Math.max(0, 1 - y * y));
    const th = ga * i;
    n.x = Math.cos(th) * r * R; n.y = y * R; n.z = Math.sin(th) * r * R;
  });
}

function computeLayout() {
  if (mode === 'grid') layoutGrid(); else layoutSphere();
}

/* ── 分组轴：主题（策展，默认）/ 来源 ───────────────────────
   原来横轴写死 12 个来源分列——那是权宜。策展后默认按主题分列。 */
let axis = 'tag';
const TAGI = new Map((CUR.tags || []).map((t, i) => [t.id, i]));
function giOf(n) {
  if (axis === 'src') return n.ci;
  const t = (n.tags || [])[0];
  return TAGI.has(t) ? TAGI.get(t) : (CUR.tags || []).length;   // 未分类进最后一列
}
function groups() {
  if (axis === 'src') return sources.map((s, i) => ({ id: s.id, label: s.label, color: PALETTE[i % PALETTE.length] }));
  const g = (CUR.tags || []).map(t => ({ id: t.id, label: t.name, color: t.color }));
  const un = nodes.filter(x => !TAGI.has((x.tags || [])[0])).length;
  if (un) g.push({ id: '__un', label: '未分类', color: '#4a4a55' });
  return g;
}
function matches(x) {
  if (!filter) return true;
  if (axis === 'src') return x.src === filter;
  if (filter === '__un') return !TAGI.has((x.tags || [])[0]);
  return (x.tags || []).includes(filter);
}

/* ── 投影 ───────────────────────────────────────────── */
function project(n) {
  if (mode === 'grid') {                    // 图谱：正交，无透视
    const s = zoom;
    return { sx: CX + (n.gx + panX - CX) * s, sy: CY + (n.gy + panY - CY) * s, s: s * 1.25, z: 0 };
  }
  const cy = Math.cos(rotY), sy = Math.sin(rotY);
  let x = n.x * cy - n.z * sy;
  let z = n.x * sy + n.z * cy;
  const cx = Math.cos(rotX), sx = Math.sin(rotX);
  const y = n.y * cx - z * sx;
  const z2 = n.y * sx + z * cx;
  const D = 1500;
  const s = zoom * D / (D + z2 + 700);
  return { sx: CX + x * s, sy: CY - y * s, s, z: z2 };
}

/* ── 渲染 ───────────────────────────────────────────── */
let frame = 0;
function render() {
  frame++;
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  ctx.clearRect(0, 0, W, H);
  // 背景微光
  const g = ctx.createRadialGradient(CX, CY, 0, CX, CY, Math.max(W, H) * 0.62);
  g.addColorStop(0, 'rgba(30,32,48,0.55)');
  g.addColorStop(1, 'rgba(8,8,10,0)');
  ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);

  const pts = nodes.map(n => ({ n, ...project(n) }));
  const visible = n => matches(n) && (!onlyMine || !!marks[n.id]);
  const G = groups();

  // 图谱模式：列带 + 层级参考线 + 列顶标签（形式参考 candobear 学科图谱）
  if (mode === 'grid') {
    const s = zoom;
    const gx0 = CX + (gridX0 + panX - CX) * s;
    const colW = gridColW * s;
    const maxLv = Math.max(...nodes.map(n => n.level));
    for (let i = 0; i < G.length; i++) {
      ctx.globalAlpha = (!filter || filter === G[i].id) ? 0.055 : 0.012;
      ctx.fillStyle = G[i].color;
      ctx.fillRect(gx0 + i * colW, 0, colW - 1.5, H);
    }
    ctx.globalAlpha = 1;
    ctx.font = '9px -apple-system,"PingFang SC",sans-serif';
    ctx.strokeStyle = 'rgba(255,255,255,0.05)';
    ctx.lineWidth = 1;
    for (let lv = 0; lv <= maxLv; lv++) {
      const y = CY + (gridTop + lv * gridGap + panY - CY) * s;
      if (y < 58 || y > H - 26) continue;
      ctx.beginPath(); ctx.moveTo(gx0, y); ctx.lineTo(gx0 + G.length * colW, y); ctx.stroke();
      ctx.fillStyle = 'rgba(255,255,255,0.2)'; ctx.textAlign = 'left';
      ctx.fillText('L' + lv, gx0 + G.length * colW + 9, y + 3);
    }
    ctx.textAlign = 'center';
    for (let i = 0; i < G.length; i++) {
      ctx.globalAlpha = (!filter || filter === G[i].id) ? 0.8 : 0.2;
      ctx.fillStyle = G[i].color;
      const cnt = axis === 'src' ? nodes.filter(x => x.src === G[i].id).length
        : G[i].id === '__un' ? nodes.filter(x => !TAGI.has((x.tags || [])[0])).length
        : nodes.filter(x => (x.tags || [])[0] === G[i].id).length;
      ctx.fillText(G[i].label + ' ' + cnt, gx0 + i * colW + colW / 2, gridTop - 28);
    }
    ctx.globalAlpha = 1;
  }

  // 边：票数分档 —— 骨架（≥7 票，多次投票一致）画实线，候选（1–4 票）画虚线
  ctx.lineWidth = 1;
  for (const [tid, pid, votes] of edges) {
    const a = byId.get(tid), b = byId.get(pid);
    if (!visible(a) || !visible(b)) continue;
    const pa = project(a), pb = project(b);
    const depth = (pa.z + pb.z) / 2;
    const hot = selected && (tid === selected || pid === selected)
             || hovered && (tid === hovered || pid === hovered);
    const solid = votes >= 7;
    const mid = votes >= 2;
    const base = solid ? 0.26 : mid ? 0.12 : 0.06;
    const alpha = hot ? 0.8 : Math.max(0.022, base - depth / 12000);
    ctx.strokeStyle = hot ? 'rgba(255,255,255,' + alpha + ')'
                          : solid ? 'rgba(178,188,225,' + alpha + ')'
                                  : 'rgba(120,128,165,' + alpha + ')';
    ctx.lineWidth = hot ? 1.6 : solid ? 1.05 : 0.6;
    if (!solid && !hot) ctx.setLineDash(votes >= 2 ? [2.5, 3] : [1.5, 4]);
    ctx.beginPath(); ctx.moveTo(pa.sx, pa.sy); ctx.lineTo(pb.sx, pb.sy); ctx.stroke();
    if (!solid && !hot) ctx.setLineDash([]);
  }

  // 点（远的先画）
  pts.sort((a, b) => b.z - a.z);
  for (const p of pts) {
    const n = p.n;
    const on = visible(n);
    const isSel = selected === n.id, isHov = hovered === n.id;
    const base = (2.2 + Math.sqrt(neighbors.get(n.id).pre.length +
                   neighbors.get(n.id).post.length) * 1.05) * p.s;
    const r = Math.max(1.1, base * (isSel ? 2.1 : isHov ? 1.65 : 1));
    const col = G[Math.min(giOf(n), G.length - 1)].color;
    ctx.globalAlpha = on ? Math.min(1, 0.42 + p.s * 0.7) : 0.06;
    // 光晕
    if (isSel || isHov) {
      ctx.shadowBlur = 22; ctx.shadowColor = col;
    }
    ctx.beginPath(); ctx.arc(p.sx, p.sy, r, 0, 6.2832);
    ctx.fillStyle = col; ctx.fill();
    ctx.shadowBlur = 0;
    // 我的标记环：只加环，不改填充色，不动坐标
    const mk = marks[n.id];
    if (mk && on) {
      ctx.globalAlpha = (isSel || isHov) ? 1 : 0.92;
      ctx.strokeStyle = mk === 'gap' ? '#ff4d4d' : '#5ee0c0';
      ctx.lineWidth = mk === 'gap' ? 2 : 1.4;
      ctx.beginPath(); ctx.arc(p.sx, p.sy, r + 2.8, 0, 6.2832); ctx.stroke();
    }
    if (isSel) {
      ctx.strokeStyle = '#fff'; ctx.lineWidth = 1.4; ctx.globalAlpha = 1;
      ctx.beginPath(); ctx.arc(p.sx, p.sy, r + 3.5, 0, 6.2832); ctx.stroke();
    }
  }
  ctx.globalAlpha = 1;
  requestAnimationFrame(render);
}

/* ── 尺寸 ───────────────────────────────────────────── */
function resize() {
  DPR = Math.min(2, window.devicePixelRatio || 1);
  W = window.innerWidth; H = window.innerHeight;
  cvs.width = W * DPR; cvs.height = H * DPR;
  cvs.style.width = W + 'px'; cvs.style.height = H + 'px';
  CX = W * (W > 820 ? 0.63 : 0.5);
  CY = H * 0.52;
  if (mode === 'grid' && nodes.length) layoutGrid();
}
window.addEventListener('resize', resize);

/* ── 交互 ───────────────────────────────────────────── */
let dragging = false, moved = 0, lastX = 0, lastY = 0;
cvs.addEventListener('pointerdown', e => {
  dragging = true; moved = 0; lastX = e.clientX; lastY = e.clientY;
  cvs.classList.add('drag'); cvs.setPointerCapture(e.pointerId);
});
cvs.addEventListener('pointermove', e => {
  if (dragging) {
    const dx = e.clientX - lastX, dy = e.clientY - lastY;
    moved += Math.abs(dx) + Math.abs(dy);
    if (mode === 'grid') { panX += dx; panY += dy; }
    else { rotY += dx * 0.0062; rotX = Math.max(-1.25, Math.min(1.25, rotX + dy * 0.0062)); }
    lastX = e.clientX; lastY = e.clientY;
  } else {
    hovered = pick(e.clientX, e.clientY);
    cvs.style.cursor = hovered ? 'pointer' : 'grab';
    if (hovered) {
      const n = byId.get(hovered);
      tip.textContent = n.name;
      tip.style.left = (e.clientX + 14) + 'px';
      tip.style.top = (e.clientY - 10) + 'px';
      tip.classList.add('on');
    } else tip.classList.remove('on');
  }
});
cvs.addEventListener('pointerup', e => {
  dragging = false; cvs.classList.remove('drag');
  if (moved < 5) { const hit = pick(e.clientX, e.clientY); hit ? openPanel(hit) : closePanel(); }
});
cvs.addEventListener('pointerleave', () => { tip.classList.remove('on'); hovered = null; });
cvs.addEventListener('wheel', e => {
  e.preventDefault();
  zoom = Math.max(0.35, Math.min(3.2, zoom * (1 - e.deltaY * 0.0011)));
}, { passive: false });

function pick(mx, my) {
  let best = null, bestD = 15;
  for (const n of nodes) {
    const p = project(n);
    const d = Math.hypot(p.sx - mx, p.sy - my);
    if (d < bestD) { bestD = d; best = n.id; }
  }
  return best;
}

/* ── 面板 ───────────────────────────────────────────── */
function openPanel(id) {
  selected = id;
  const n = byId.get(id), nb = neighbors.get(id);
  const src = sources.find(s => s.id === n.src);
  const pre = nb.pre.map(x => byId.get(x)).filter(Boolean);
  const post = nb.post.map(x => byId.get(x)).filter(Boolean);
  document.getElementById('pbody').innerHTML = `
    <div class="src">${src ? src.label : n.src} · ${n.type}</div>
    <h2>${n.name}</h2>
    <div class="gloss">${n.gloss}</div>
    <div class="metrics">
      <div class="m"><b>${pre.length}</b><span>前置</span></div>
      <div class="m"><b>${post.length}</b><span>解锁</span></div>
      <div class="m"><b>L${n.level}</b><span>层级</span></div>
    </div>
    <div class="markrow">
      <button class="mk${marks[id] === 'learned' ? ' on' : ''}" onclick="setMark('${id}','learned')">学过</button>
      <button class="mk gap${marks[id] === 'gap' ? ' on' : ''}" onclick="setMark('${id}','gap')">漏点没补</button>
      <button class="mk${marks[id] ? '' : ' quiet'}" onclick="setMark('${id}','none')">清除</button>
    </div>
    ${pre.length ? `<h5>要理解它，先懂这些</h5><ul>${pre.map(x =>
      `<li onclick="openPanel('${x.id}')">${x.name}<em>L${x.level}</em></li>`).join('')}</ul>` : ''}
    ${post.length ? `<h5>懂了它，才能懂这些</h5><ul>${post.map(x =>
      `<li onclick="openPanel('${x.id}')">${x.name}<em>L${x.level}</em></li>`).join('')}</ul>` : ''}
  `;
  document.getElementById('panel').classList.add('on');
}
function closePanel() {
  selected = null;
  document.getElementById('panel').classList.remove('on');
}
window.openPanel = openPanel; window.closePanel = closePanel;

/* ── 图例：按主题（策展）/ 按来源 ─────────────────────────── */
function buildLegend() {
  const G = groups();
  document.getElementById('lrows').innerHTML = G.map(g => {
    // 按主题时数字＝**主标签**数，跟画布上那一列的点数一一对应；
    // 「相关但主标签在别处」的点数写在策展面板里，免得两个口径打架。
    const cnt = axis === 'src' ? nodes.filter(x => x.src === g.id).length
      : g.id === '__un' ? nodes.filter(x => !TAGI.has((x.tags || [])[0])).length
      : nodes.filter(x => (x.tags || [])[0] === g.id).length;
    return `<div class="lrow${filter && filter !== g.id ? ' off' : ''}" data-g="${g.id}">
      <span class="dot" style="background:${g.color}"></span>
      ${g.label}<span class="n">${cnt}</span></div>`;
  }).join('');
  document.getElementById('lhead').textContent = axis === 'tag'
    ? '主题 · 点击筛选（数字＝主标签）' : '来源 · 点击筛选';
  document.getElementById('ax-tag').classList.toggle('on', axis === 'tag');
  document.getElementById('ax-src').classList.toggle('on', axis === 'src');
  document.querySelectorAll('#lrows .lrow').forEach(el => {
    el.onclick = () => {
      const g = el.dataset.g;
      filter = (filter === g) ? null : g;
      buildLegend();
    };
  });
}
function setAxis(a) {
  axis = a; filter = null;
  computeLayout(); buildLegend();
}
window.setAxis = setAxis;

/* ── 启动 ───────────────────────────────────────────── */
function setMode(m) {
  mode = m;
  document.querySelectorAll('.tab').forEach(t => t.classList.toggle('on', t.dataset.mode === m));
  panX = panY = 0; rotX = -0.22; rotY = 0.5; zoom = m === 'grid' ? 1 : 1.35;
  const h = document.querySelector('.hint');   // 壳里已无 .hint，改写到左栏
  if (h) h.innerHTML = '<b>实线</b> 骨架 · <b>虚线</b> 候选';
  const rh = document.getElementById('rhint');
  if (rh) rh.innerHTML = (m === 'grid'
    ? '<b>拖拽</b> 平移 · <b>滚轮</b> 缩放'
    : '<b>拖拽</b> 旋转 · <b>滚轮</b> 缩放') + '<br><b>点一个点</b> 看它的来路';
  computeLayout();
}

function boot() {
  resize();
  buildLegend();
  refreshMarks();
  document.getElementById('kicker').textContent = meta.kicker;
  document.getElementById('stats').innerHTML = meta.stats;
  document.querySelectorAll('.tab').forEach(t => { t.onclick = () => setMode(t.dataset.mode); });
  computeLayout();
  render();
  requestAnimationFrame(() => document.getElementById('load').classList.add('off'));
  const h = decodeURIComponent(location.hash.slice(1));
  if (h === 'sphere' || h === 'grid') setMode(h);
  else if (h && byId.has(h)) openPanel(h);
}
setTimeout(boot, 40);

/* ══ 壳：三个入口 import / insert / Agent ═══════════════════════
   所有者 05:38 的定义：
     import = 知识体系（两个图）  insert = llm_wiki 的挖掘/提问  Agent = 选方法论
   两棵树（05:09）：全量树 = 所有点；自己的树 = 只显示已标记的点（同一张图两个图层） */
let onlyMine = false;
const INSERT_KEY = 'zss135.insert.v1';
let insertMarks = {};
try { insertMarks = JSON.parse(localStorage.getItem(INSERT_KEY) || '{}') || {}; } catch (e) { insertMarks = {}; }
const saveInsert = () => { try { localStorage.setItem(INSERT_KEY, JSON.stringify(insertMarks)); } catch (e) {} };

const SKEL = edges.filter(e => e[2] >= 7);   // 骨架（多次一致）
const CAND = edges.filter(e => e[2] < 7);    // 候选（机器推的、只出现一次的那批）

function refreshRail() {
  const mine = nodes.filter(n => marks[n.id]).length;
  const autoN = CUR.edgeAuto ? CUR.edgeAuto.length : 0;
  const humanKey = new Set(CUR.edgeHuman || []);
  const pending = (CUR.edgeHuman || []).filter(k => !insertMarks[k]).length;
  const e1 = document.getElementById('r-all');
  const e2 = document.getElementById('r-todo');
  const e3 = document.getElementById('r-mine');
  const e5 = document.getElementById('r-cur');
  if (e1) e1.textContent = nodes.length + ' 点 · ' + (CUR.tags || []).length + ' 条线 · ' + SKEL.length + ' 骨架';
  if (e2) e2.textContent = pending + ' 条要你看（我自己判了 ' + autoN + ' 条）';
  if (e3) e3.textContent = mine ? mine + ' 个已标记' : '还没标过';
  if (e5) e5.textContent = (CUR.tags || []).length + ' 条线已排好路线';
  const e4 = document.getElementById('r-chat');
  if (e4) e4.textContent = activeSkill ? ('用：' + activeSkill) : '选方法论';
}
window.refreshRail = refreshRail;

function setView(v) {
  document.querySelectorAll('.r-item').forEach(b => b.classList.toggle('on', b.dataset.view === v));
  if (v === 'mine') { onlyMine = true; closePanel(); }
  else if (v === 'graph') { onlyMine = false; closePanel(); }
  else if (v === 'curate') { onlyMine = false; openCurate(); }
  else if (v === 'todo') { onlyMine = false; openInsert(); }
  else if (v === 'chat') { onlyMine = false; openAgent(); }
  refreshRail();
}
window.setView = setView;

function doImport() {
  setView('graph');
  const b = document.getElementById('b-import');
  b.classList.add('flash'); setTimeout(() => b.classList.remove('flash'), 520);
}
function doInsert() { setView('todo'); }
function doAgent() { setView('chat'); }
window.doImport = doImport; window.doInsert = doInsert; window.doAgent = doAgent;

function openInsert() {
  document.getElementById('panel').classList.add('on');
  const auto = CUR.edgeAuto || [];
  const autoKeep = auto.filter(a => a.verdict === 'keep').length;
  const autoSkip = auto.length - autoKeep;
  const humanKeys = CUR.edgeHuman || [];
  const em = new Map(edges.map(e => [e[0] + '_' + e[1], e]));
  const left = humanKeys.filter(k => !insertMarks[k]).length;
  document.getElementById('pbody').innerHTML = `
    <div class="src">insert · 机器挖出来的连接</div>
    <h2>我自己判了 ${auto.length} 条，剩 ${left} 条要你看一眼</h2>
    <div class="mut">候选边一共 ${CAND.length} 条（骨架那 ${SKEL.length} 条多次一致，不用管）。<br>
    我按「先懂什么才能懂什么」逐条过了一遍：<b class="auto">采纳 ${autoKeep}</b> · <b>跳过 ${autoSkip}</b>。<br>
    下面这些是我<b>自己也没把握</b>的——跨篇、票数又高，判错了会串线，所以留给你。
    <b>你不看也不影响</b>，它们默认按我的判断走。</div>
    <div class="ilist">${humanKeys.map(k => {
      const e = em.get(k); if (!e) return '';
      const a = byId.get(e[0]), c = byId.get(e[1]);
      const st = insertMarks[k];
      const au = AUTO.get(k);
      return `<div class="irow ${st || ''}">
        <div class="itxt"><b>${a ? a.name : e[0]}</b> 依赖 <b>${c ? c.name : e[1]}</b>
        <span class="mut"> · 票 ${e[2]}/4</span>
        ${au ? `<div class="mut" style="margin-top:4px">我的猜测：${au.verdict === 'keep' ? '采纳' : au.verdict === 'skip' ? '跳过' : '拿不准'}
        （把握 ${(au.conf * 100).toFixed(0)}%）—— ${au.why}</div>` : ''}</div>
        <div class="iact">
          <button class="${st === 'keep' ? 'on' : ''}" onclick="markInsert('${k}','keep')">采纳</button>
          <button class="${st === 'skip' ? 'on' : ''}" onclick="markInsert('${k}','skip')">跳过</button>
        </div></div>`;
    }).join('')}</div>
    <div class="mut">已表态 ${humanKeys.length - left} / ${humanKeys.length}。<br>
    我判过的那 ${auto.length} 条写在 <code>evidence/concept-edges-curated-20260912.json</code>，随时可查、可翻案。</div>`;
}
function markInsert(k, v) {
  if (insertMarks[k] === v) delete insertMarks[k]; else insertMarks[k] = v;
  saveInsert(); openInsert(); refreshRail();
}
window.markInsert = markInsert;

/* 策展：10 条线，每条已经排好路线。用户不必自己找入口。 */
function openCurate() {
  const C = CUR.collections || [];
  document.getElementById('panel').classList.add('on');
  document.getElementById('pbody').innerHTML = `
    <div class="src">策展 · ${C.length} 条线</div>
    <h2>这 ${nodes.length} 个点，我已经分成 ${C.length} 条线</h2>
    <div class="mut">每条线给了：<b>为什么值得走</b>、<b>从哪进</b>（门槛最低的）、<b>走到哪算完</b>（最抽象的）、
    以及一条沿着真实依赖边的<b>路线</b>。<br>点一条线看路线，再点「只看这条线」把它单独铺开。</div>
    ${C.map(c => `<div class="crow" onclick="openCollection('${c.tagId}')">
      <b><span class="dot" style="background:${c.color}"></span>${c.name}
        <span class="badge">主标签 ${c.primary ?? c.size}</span>
        <span class="badge">相关 ${c.size}</span></b>
      <span>${c.why}</span>
      <i>入口 ${c.entry.map(e => e.name).join(' · ')}</i>
    </div>`).join('')}`;
}

function openCollection(tid) {
  const c = (CUR.collections || []).find(x => x.tagId === tid);
  const t = (CUR.tags || []).find(x => x.id === tid);
  if (!c) return;
  document.getElementById('panel').classList.add('on');
  document.getElementById('pbody').innerHTML = `
    <div class="src">策展 · 一条线</div>
    <h2><span class="dot" style="background:${c.color};display:inline-block;margin-right:8px"></span>${c.name}</h2>
    <div class="gloss">${c.why}</div>
    <div class="metrics">
      <div class="m"><b>${c.size}</b><span>个点</span></div>
      <div class="m"><b>${c.route.length}</b><span>跳路线</span></div>
      <div class="m"><b>${c.primary ?? c.size}</b><span>主标签</span></div>
      <div class="m"><b>${c.size}</b><span>相关点</span></div>
    </div>
    <div class="markrow">
      <button class="mk" onclick="focusTag('${tid}')">只看这条线</button>
      <button class="mk quiet" onclick="openCurate()">回到 ${(CUR.collections || []).length} 条线</button>
    </div>
    <h5>从哪进 · 组内没有前置、且解锁最多的</h5>
    <ul>${c.entry.map(e => `<li onclick="openPanel('${e.id}')">${e.name}<em>解锁 ${e.unlocks ?? '?'}</em></li>`).join('')}</ul>
    <h5>路线 · 先懂什么再懂什么</h5>
    <div class="stops">${c.route.map(st => `<div class="stop" onclick="openPanel('${st.id}')">
      <span class="lv">L${st.level}</span>
      <span class="nm">${st.name}</span>
      <span class="ed">${st.edgeFromPrev === 'skel' ? '骨架' : st.edgeFromPrev === 'cand' ? '候选' : '起点'}</span>
    </div>`).join('')}</div>
    <h5>收敛点 · 这条线上被依赖最多的</h5>
    <ul>${c.goal.map(g => `<li onclick="openPanel('${g.id}')">${g.name}<em>L${g.level}</em></li>`).join('')}</ul>
    <h5>这条线上的全部 ${c.size} 个点</h5>
    <ul>${nodes.filter(x => (x.tags || []).includes(tid)).map(x =>
      `<li onclick="openPanel('${x.id}')">${x.name}<em>L${x.level}</em></li>`).join('')}</ul>`;
}
function focusTag(tid) {
  axis = 'tag'; filter = tid;
  setView('graph'); buildLegend(); computeLayout(); closePanel();
}
window.openCurate = openCurate; window.openCollection = openCollection; window.focusTag = focusTag;

/* Agent：卡片上的 prompt 不再是我手抄的摘要 —— 直接用 .agents/skills/<name>/SKILL.md 原文。
   （所有者问「怎么样去调用 DBS 的 skill 啊？」——这就是答案：服务端读原文件当 system prompt。）*/
const PINNED = [
  { name: '135 学习闭环', skill: null, span: '这个项目的闭环', note: '1 阅读器 → 3 决策场 → 5 实验台 → 费曼验收' },
  { name: 'dbs-learning-beta', skill: 'dbs-learning-beta', span: '没有标准答案的课题', note: '判课题类型 → 判据 · 代价 · 只有你能回答的裁决点 · 最小实验' },
  { name: 'dbs-standard-answer', skill: 'dbs-standard-answer', span: '要一个带条件的答案', note: '理论挖掘 + 历史同构（成功 / 失败 / 反例）' },
];
let ALLSKILLS = null;

async function openAgent() {
  document.getElementById('panel').classList.add('on');
  renderAgent(PINNED, '载入中…');
  try {
    const r = await fetch('/api/skills');
    const j = await r.json();
    ALLSKILLS = j.skills || [];
  } catch (e) { ALLSKILLS = []; }
  renderAgent(PINNED, ALLSKILLS.length
    ? `已装 ${ALLSKILLS.length} 个 skill：<code>${ALLSKILLS[0].name}</code> … <code>${ALLSKILLS[ALLSKILLS.length - 1].name}</code>`
    : '（离线·读不到 <code>.agents/skills/</code>，只有上面三个内置的可用）');
}
function renderAgent(pinned, foot) {
  const rows = pinned.map(p => `<button class="acard" onclick="pickAgent('${p.skill || p.name}', ${p.skill ? `'${p.skill}'` : 'null'})">
      <b>${p.name}</b><span>${p.span}</span><i>${p.note}</i></button>`).join('');
  const others = (ALLSKILLS || []).filter(x => !PINNED.some(p => p.skill === x.name));
  document.getElementById('pbody').innerHTML = `
    <div class="src">Agent · 用哪套方法论</div>
    <h2>先问一句：这个课题有标准答案吗？</h2>
    <div class="mut">有 → 135 闭环；没有 → dbs-learning-beta。<br>
    <b>选中的 skill 原文</b>（不是摘要）会被当成 system prompt 发给模型。<br>${foot}</div>
    <div class="alist">${rows}</div>
    ${others.length ? `<h5>其余已装 skill（点一下直接用）</h5>
    <div class="alist">${others.map(x => `<button class="acard" onclick="pickAgent('${x.name}', '${x.name}')">
      <b>${x.name}</b><span>${(x.description || '').slice(0, 58)}${(x.description || '').length > 58 ? '…' : ''}</span>
      <i>${(x.bytes / 1024).toFixed(1)} KB · SKILL.md 原文</i></button>`).join('')}</div>` : ''}`;
}
window.openAgent = openAgent;

refreshRail();


/* ══ 对话：选一个方法论，然后真的能问 ─────────────────────────
   经 http://127.0.0.1:5180/知所栖-壳.html 打开时走 /api/llm（真 LLM）；
   双击 file:// 打开时没有 /api，给一句诚实的离线说明并指路。 */
const SKILLS = {
  '135 学习闭环': {
    tag: '有标准答案的知识型课题',
    sys: '你是「知所栖 135」的学习编排器。固定顺序，不许跳步、不许替学习者决定：'
       + '① 1 阅读器 = 给 3 个概念，每个给三层梯度（L1 直觉 / L2 机制 / L3 应用）；'
       + '② 3 决策场 = 先让学习者自己选，再给真实案例与「条件 → 路线」表；'
       + '③ 5 实验台 = 一个 5 分钟能做的最小实验，必须让他动手判断；'
       + '④ 费曼验收 = 让他用自己的话复述，逐点查漏，漏哪倒回哪。'
       + '用户说想学什么时，你只做第 ① 步，给完 3 个概念就停，等他反馈。不要一次给完四步。'
  },
  'dbs-learning-beta': {
    tag: '没有标准答案的课题',
    sys: '先判课题类型（伪问题／主观判断／个人决策／价值问题），然后输出：判据、代价、'
       + '只有用户本人能回答的裁决点、一个最小实验。'
       + '如果判定为知识型课题（有标准答案），说明并交回 135 闭环，不继续本流程。'
       + '绝不替用户做决定，不写「你应该」。'
  },
  'dbs-standard-answer': {
    tag: '要一个带条件的答案',
    sys: '两部分：① 知识与理论挖掘——先审查命题（绝对化／因果跳跃／定义偷换／经验普遍化／反向推断），'
       + '再找相关学科、作者、理论，核实来源，写清能解释什么、解释不了什么；'
       + '② 历史同构——成功案例、失败案例、反例，最后给一个带条件、带因果解释、带失效边界的答案。'
       + '找不到就写「尚无统一答案」，不许硬套名人。'
  },
};
var activeSkill = null;
var activeFile = null;   // 非空 = 用 .agents/skills/<activeFile>/SKILL.md 当 system prompt
var msgs = [];

function renderConv() {
  const body = document.getElementById('pbody');
  document.getElementById('panel').classList.add('on');
  const tagOf = activeSkill
    ? ((SKILLS[activeSkill] && SKILLS[activeSkill].tag)
       || (ALLSKILLS || []).find(x => x.name === activeSkill)?.description?.slice(0, 44)
       || '已装 skill')
    : '';
  const head = activeSkill
    ? `<div class="src">会话 · ${activeSkill}${activeFile ? ' · SKILL.md 原文' : ' · 内置'}</div><h2>${tagOf}</h2>`
    : `<div class="src">会话</div><h2>先选一个方法论</h2>`;
  const hint = activeSkill ? '' :
    `<div class="mut">点底栏的 <b>Agent</b> 选一个，再在下面的输入框里问我。<br>
     <b>选哪个不由系统替你决定。</b></div>`;
  const rows = msgs.map(m => `<div class="cmsg ${m.role}${m.pending ? ' pend' : ''}">${
    esc(m.content).replace(/\n/g, '<br>')}</div>`).join('');
  body.innerHTML = head + hint
    + `<div class="clist" id="clist">${rows || (activeSkill ? '<div class="mut">说吧，你想学什么。</div>' : '')}</div>`;
  const cl = document.getElementById('clist');
  if (cl) cl.scrollTop = cl.scrollHeight;
}
function esc(t) { return String(t).replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c])); }

function openConv() { renderConv(); }

async function send() {
  const q = document.getElementById('b-q');
  const text = (q.value || '').trim();
  if (!text) return;
  q.value = '';
  msgs.push({ role: 'user', content: text });
  if (!activeSkill) {
    msgs.push({ role: 'assistant', content: '先选一个方法论：点底栏的 Agent。' });
    renderConv(); refreshRail(); return;
  }
  msgs.push({ role: 'assistant', content: '…', pending: true });
  renderConv();
  const history = msgs.filter(m => !m.pending).map(m => ({ role: m.role, content: m.content }));
  try {
    const payload = activeFile
      ? { json: false, skill: activeFile, messages: history }              // 服务端读真 SKILL.md
      : { json: false, messages: [{ role: 'system', content: (SKILLS[activeSkill] || {}).sys || '' }, ...history] };
    const r = await fetch('/api/llm', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const j = await r.json();
    const out = j.error
      ? `（没跑起来：${j.error}${j.detail ? ' — ' + String(j.detail).slice(0, 160) : ''}）`
      : (j.content ?? j.text ?? j.choices?.[0]?.message?.content
         ?? j.data?.content ?? (typeof j === 'string' ? j : JSON.stringify(j)));
    msgs[msgs.length - 1] = { role: 'assistant', content: out };
  } catch (e) {
    msgs[msgs.length - 1] = { role: 'assistant', content:
      '（离线）没连上本地服务，所以这句不是真回答。\n'
      + '要真对话：项目根目录跑 `node scripts/serve-135.mjs`，然后开 http://127.0.0.1:5180/知所栖-壳.html —— 同一个地址下 /api/llm 才通。' };
  }
  renderConv();
}
window.send = send;
window.openConv = openConv;

/* Agent 卡片：选中即生效，并切到会话 */
window.pickAgent = function (label, file) {
  activeSkill = label;
  activeFile = file || null;
  const q = document.getElementById('b-q');
  q.placeholder = label + ' · 我想学 ____（回车发送）';
  const desc = SKILLS[label] ? SKILLS[label].tag
    : (ALLSKILLS || []).find(x => x.name === label)?.description || '已装 skill';
  msgs = [{ role: 'assistant', content: '用「' + label + '」。' + desc + '\n'
    + (activeFile ? '（system prompt = .agents/skills/' + activeFile + '/SKILL.md 原文）' : '（内置闭环）')
    + '——说吧，你想学什么？' }];
  setView('chat');
  renderConv(); refreshRail();
  q.focus();
};

/* 底栏输入框：回车发送 */
document.getElementById('b-q').addEventListener('keydown', e => {
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
});

</script>
</body>
</html>
